# Copy this file to your panel's ssl/ directory as ssh-sync.env
# (e.g. ./data/ssl/ssh-sync.env in Docker, or /var/lib/softether-manager/ssl/ssh-sync.env).
# Also copy scripts/sync-chain-certs-ssh.sh to ssl/hook.sh and run: chmod +x ssl/hook.sh

# Remote SoftEther VPN host (defaults to the connected server's host if omitted)
# SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=root

# Path to private key inside the panel container/host (chmod 600).
# If omitted, automatically checks ssl/id_ed25519 then ssl/id_rsa.
# SSH_KEY=/data/ssl/id_ed25519

# Remote SoftEther chain_certs/ directory.
# Official SoftEther Docker container: /var/lib/softether/chain_certs
# Standard Linux install (install.sh): /opt/vpnserver/chain_certs
# If omitted, the script probes common SoftEther directories automatically.
# REMOTE_CHAIN_DIR=/var/lib/softether/chain_certs

# Host key policy: accept-new (default, TOFU) | yes (strict, pre-populated known_hosts)
# SSH_STRICT_HOST_KEY_CHECKING=accept-new
# SSH_KNOWN_HOSTS=/data/ssl/known_hosts
