#!/usr/bin/env bash
set -e

# SoftEther Manager Container CLI wrapper
case "${1:-}" in
  status)
    echo "=========================================="
    echo "    SoftEther Manager Container Status    "
    echo "=========================================="
    python3 -m app.address
    echo ""
    echo "--- SoftEther Target Connection ---"
    python3 -c "
from app.se import connection
c = connection()
print(f\"Host: {c['host']}:{c['port']}\")
print(f\"Configured: {'Yes' if c['configured'] else 'No (set password to connect)'}\")
"
    echo ""
    echo "--- Panel Users ---"
    python3 -m app.manage users
    echo "=========================================="
    ;;
  users)
    python3 -m app.manage users
    ;;
  password)
    shift
    python3 -m app.manage password "$@"
    ;;
  connect)
    shift
    python3 -m app.manage connect "$@"
    ;;
  webpath)
    shift
    python3 -m app.manage webpath "$@"
    ;;
  domain)
    shift
    python3 -m app.manage domain "$@"
    ;;
  *)
    cat << 'EOF'
SoftEther Manager - Docker CLI (sem)

Usage:
  sem status                              Display container & connection status
  sem users                               List panel administrator accounts
  sem password --username <name> --password <pass>
                                          Create or update a panel account
  sem connect --host <ip/host> --port <port> --password <pass>
                                          Configure LAN SoftEther server connection
  sem webpath [prefix]                    Set or clear the secret web path
  sem domain [show|set <name>|clear|only on|off]
                                          Manage custom domain & TLS

Examples:
  docker exec -it softether-manager sem status
  docker exec -it softether-manager sem password --username admin --password secret
  docker exec -it softether-manager sem connect --host 192.168.1.100 --port 5555 --password vpnadmin
EOF
    ;;
esac
