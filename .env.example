# =============================================================================
# SoftEther Manager Docker 环境变量配置文件模板 (.env)
# =============================================================================

# 1. 局域网内 SoftEther VPN 服务器配置
# 填写局域网 SoftEther 服务器的 IP（如 192.168.1.100）或主机名
SEM_SE_HOST=192.168.1.100
# SoftEther 管理端口 (默认 5555)
SEM_SE_PORT=5555
# SoftEther 服务器管理员密码 (可选)
SEM_SE_PASSWORD=

# 2. 面板管理员账号配置 (首次启动自动创建，可选)
SEM_ADMIN_USERNAME=admin
SEM_ADMIN_PASSWORD=

# 3. 运行端口与路径
SEM_BIND_PORT=8000
# 隐蔽访问路径前缀 (留空表示根路径 /)
SEM_WEB_PATH=

# 4. 数据目录
SEM_DATA_DIR=/data
