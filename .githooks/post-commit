#!/usr/bin/env bash
set -euo pipefail

# A path-limited commit uses a temporary index; sync only its version bump
# back to the regular index after Git has released the index lock.
unset GIT_INDEX_FILE
cd "$(git rev-parse --show-toplevel)"
committed_version="$(git show HEAD:VERSION)"
previous_version="$(git show HEAD^:VERSION 2>/dev/null || true)"
if [[ "$(cat VERSION)" == "$committed_version" &&
      "$(git show :VERSION)" == "$previous_version" ]]; then
  git add -- VERSION
fi
