#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
staged_version="$(git show :VERSION)"
if [[ ! "$staged_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  printf 'error: VERSION must contain MAJOR.MINOR.PATCH\n' >&2
  exit 1
fi

head_version="$(git show HEAD:VERSION 2>/dev/null || true)"
# Keep explicit version changes, including a bump staged by an earlier attempt.
if [[ "$staged_version" != "$head_version" ]] || git diff --cached --quiet; then
  exit 0
fi
if [[ "$(cat VERSION)" != "$staged_version" ]]; then
  printf 'error: VERSION has unstaged changes; stage or restore it before committing\n' >&2
  exit 1
fi

is_auxiliary_file() {
  local f="$1"
  case "$f" in
    VERSION|LICENSE*|COPYING*) return 0 ;;
    README*|*.md) return 0 ;;
    docs/*|*.png|*.jpg|*.jpeg|*.svg|*.ico|*.gif|*.webp) return 0 ;;
    *_test.go|*.test.*|*.spec.*) return 0 ;;
    scripts/test*|scripts/generate_screenshots.*) return 0 ;;
    .github/*|.githooks/*|.gitignore|.gitattributes) return 0 ;;
    *) return 1 ;;
  esac
}

has_code_changes=false
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  if ! is_auxiliary_file "$file"; then
    has_code_changes=true
    break
  fi
done < <(git diff --cached --name-only)

if [[ "$has_code_changes" == false ]]; then
  # Only auxiliary files (docs, screenshots, test files, configs) staged; skip auto-bump
  exit 0
fi

IFS=. read -r major minor patch <<< "$staged_version"
next_version="$major.$minor.$((patch + 1))"
printf '%s\n' "$next_version" > VERSION
git add -- VERSION
printf 'Version: %s -> %s\n' "$staged_version" "$next_version" >&2
